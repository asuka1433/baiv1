-- Get equipped pets from DataService without crashing if the game's module layout changed.
local DataService = nil
local PetsData = {}
local EquippedPets = {}

do
    local modulesFolder = ReplicatedStorage:FindFirstChild("Modules")
    local dataServiceModule = modulesFolder and modulesFolder:FindFirstChild("DataService")

    if dataServiceModule and dataServiceModule:IsA("ModuleScript") then
        DataService = safeRequire(dataServiceModule, "DataService")
    else
        bhWarn("DataService", "ReplicatedStorage.Modules.DataService was not found")
    end

    if type(DataService) == "table" and type(DataService.GetData) == "function" then
        local okData, playerData = pcall(function()
            return DataService:GetData(LocalPlayer)
        end)

        if okData and type(playerData) == "table" and type(playerData.PetsData) == "table" then
            PetsData = playerData.PetsData
            if type(PetsData.EquippedPets) == "table" then
                EquippedPets = PetsData.EquippedPets
            end
        elseif not okData then
            bhWarn("DataService:GetData", playerData)
        else
            bhWarn("DataService:GetData", "PetsData was unavailable")
        end
    end
end


