local function bhWarn(context, err)
    warn(("[BeastHub] %s%s"):format(
        tostring(context),
        err ~= nil and (": " .. tostring(err)) or ""
    ))
end

local function firstOption(value)
    if type(value) == "table" then
        return value[1]
    end
    return value
end

local function safeRequire(moduleScript, label)
    if not moduleScript then
        bhWarn(label or "require", "module was not found")
        return nil
    end

    local ok, result = pcall(require, moduleScript)
    if not ok then
        bhWarn(label or "require", result)
        return nil
    end

    return result
end

local function safeRemoteLoad(url, label)
    if type(loadstring) ~= "function" then
        bhWarn(label or "remote load", "loadstring is unavailable in this environment")
        return nil
    end

    local okHttp, source = pcall(function()
        return game:HttpGet(url)
    end)
    if not okHttp or type(source) ~= "string" or source == "" then
        bhWarn(label or "remote load", okHttp and "empty response" or source)
        return nil
    end

    local chunk, compileErr = loadstring(source)
    if not chunk then
        bhWarn((label or "remote load") .. " compile", compileErr)
        return nil
    end

    local okRun, result = pcall(chunk)
    if not okRun then
        bhWarn((label or "remote load") .. " runtime", result)
        return nil
    end

    return result
end

-- Prevent duplicate copies of the hub from creating duplicate connections/loops.
ENV.BeastHubLoaded = ENV.BeastHubLoaded or false
ENV.ConfigLoaded = ENV.ConfigLoaded or false
ENV.preloadedCustomLoadouts = ENV.preloadedCustomLoadouts or {}
ENV.preloadedCustomLoadoutNames = ENV.preloadedCustomLoadoutNames or {}

if ENV.BeastHubLoaded then
    bhWarn("loader", "BeastHub is already running")
    return
end

-- Game events. Timeouts prevent an infinite yield if the game changes these paths.
local GameEvents = ReplicatedStorage:WaitForChild("GameEvents", 15)
if not GameEvents then
    bhWarn("startup", "ReplicatedStorage.GameEvents was not found")
    return
end

local Notification = GameEvents:WaitForChild("Notification", 10)
local Event = GameEvents:WaitForChild("Event", 10)
if not Notification then
    bhWarn("startup", "GameEvents.Notification was not found; notification listener disabled")
end
if not Event then
    bhWarn("startup", "GameEvents.Event was not found; event features may be unavailable")
end

-- Generation-based workers make toggles stop reliably and avoid duplicate loops.
local workerGeneration = {}
local function setWorker(name, enabled, delaySeconds, callback)
    workerGeneration[name] = (workerGeneration[name] or 0) + 1
    local generation = workerGeneration[name]

    if not enabled then
        return
    end

    task.spawn(function()
        while workerGeneration[name] == generation do
            local ok, err = pcall(callback)
            if not ok then
                bhWarn(name, err)
            end
            task.wait(math.max(tonumber(delaySeconds) or 0.1, 0.03))
        end
    end)
end

local BeastHubFunctions = nil
local function safeBHCall(functionName, ...)
    if type(BeastHubFunctions) ~= "table" then
        bhWarn(functionName, "BeastHubFunctions is unavailable")
        return nil
    end

    local fn = BeastHubFunctions[functionName]
    if type(fn) ~= "function" then
        bhWarn(functionName, "helper function was not found")
        return nil
    end

    local args = table.pack(...)
    local ok, result = pcall(function()
        return fn(table.unpack(args, 1, args.n))
    end)
    if not ok then
        bhWarn(functionName, result)
        return nil
    end

    return result
end


