local MailTab = Window:CreateTab("Mail", "mail")

MailTab:CreateSection("Mail - Single select")

-- Build a Rayfield-safe item list. Dropdown options must be strings, while
-- sendMail can still receive the original item object through mailItemMap.
local mailItems = {}
local mailItemMap = {}

for category, items in pairs(PetsData or {}) do
    if type(items) == "table" and category ~= "EquippedPets" then
        for key, item in pairs(items) do
            local label
            if type(item) == "table" then
                label = item.DisplayName
                    or item.ItemName
                    or item.Name
                    or item.name
                    or item.UUID
                    or item.Id
                    or item.ID
            elseif type(item) == "string" or type(item) == "number" then
                label = tostring(item)
            end

            label = tostring(label or key or "Unknown item")
            local uniqueLabel = label
            local suffix = 2
            while mailItemMap[uniqueLabel] ~= nil do
                uniqueLabel = ("%s (%d)"):format(label, suffix)
                suffix += 1
            end

            mailItemMap[uniqueLabel] = item
            table.insert(mailItems, uniqueLabel)
        end
    end
end

table.sort(mailItems)

